<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cl.duoc.pedidos360</groupId>
    <artifactId>pedidos360-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Pedidos360 :: Backend</name>
    <description>Arquitectura base de microservicios para el sistema Pedidos360 (EP1 - DSY1107)</description>

    <modules>
        <module>ms-pedidos360-bff</module>
        <module>ms-pedidos360-orders</module>
        <module>ms-pedidos360-catalog</module>
        <module>ms-pedidos360-notify</module>
        <module>ms-pedidos360-audit</module>
        <!-- ms-pedidos360-report: fuera del alcance de EP1 (reportería/Kafka pertenece
             al caso semestral completo). Se agrega de vuelta cuando tenga su propio
             pom.xml y código real; por ahora rompía "mvn install" al no tener pom.xml. -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.4</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Fuerza el compilador a usar el JDK 21 declarado en ~/.m2/toolchains.xml,
                 sin importar qué JDK ejecuta Maven (evita romper Lombok si el JAVA_HOME
                 del sistema apunta a una version mas nueva que Lombok aun no soporta). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>21</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
