# Plantilla de configuracion del stack. Copiar a `infra/.env` y rellenar.
#
#   cp infra/.env.example infra/.env   &&   nano infra/.env
#
# `infra/.env` esta en .gitignore: NO se sube al repo y `git pull` ya no lo pisa.
# docker compose lo lee solo si se invoca con el compose de esta carpeta:
#   cd infra && docker compose up -d
# (o bien: docker compose --env-file infra/.env -f infra/docker-compose.yml up -d)

# ---------------------------------------------------------------- Entra ID
AZURE_TENANT_ID=f280f365-653c-4282-b1ee-200e91b01736
AZURE_API_CLIENT_ID=08c770a5-21a6-4434-8d59-28723c7c759d

# App Registration que el BFF usa para hablar con Microsoft Graph
# (alta de usuarios). Necesita User.ReadWrite.All y AppRoleAssignment.ReadWrite.All
# con consentimiento de administrador.
AZURE_GRAPH_CLIENT_ID=08c770a5-21a6-4434-8d59-28723c7c759d
# SECRETO: pegar el client secret real. Nunca commitear este archivo.
AZURE_GRAPH_CLIENT_SECRET=
AZURE_USER_DOMAIN=ActividadClauodNative123.onmicrosoft.com
AZURE_DEFAULT_ROLE=Customer
AZURE_SELF_SERVICE_ROLES=Customer

# ------------------------------------------------------------------- CORS
# Debe coincidir con el origin configurado en API Gateway.
# En el EC2: https://<IP_PUBLICA>   (cambiar cada vez que cambie la IP)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --------------------------------------------------------------- Frontend
# EC2 (layout de ~/): contexto ../../../frontend-pedidos360 + Dockerfile.prebuilt
#   -> hay que subir el dist/ ya compilado desde el equipo local.
# Local (este repo junto al frontend): descomentar las dos lineas de abajo.
# FRONTEND_CONTEXT=../../frontend-pedidos360
# FRONTEND_DOCKERFILE=Dockerfile

# --------------------------------------------------------------- RabbitMQ
RABBITMQ_ERLANG_COOKIE=pedidos360-cluster-cookie
# Gancho de la demo de DLQ (failMode: transient | poison en el payload).
# Dejar en false fuera de la presentacion.
PEDIDOS360_SIMULATE_FAILURES=true
